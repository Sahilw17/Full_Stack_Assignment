    "start": "node dist/server.js",
    "seed": "ts-node-dev src/database/seed.ts",
    "test": "tsc && node --test dist/tests/*.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.9.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",

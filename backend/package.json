{
  "name": "dealpulse-backend",
  "version": "1.0.0",
  "description": "DealPulse AI - Intelligent B2B Sales & Revenue Workflow SaaS API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
